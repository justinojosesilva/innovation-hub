# Postgres. Local: docker-compose (host port 5433 -> container 5432).
# Production: Neon POOLED connection string (host with `-pooler`, ?sslmode=require).
DATABASE_URL="postgresql://hub:hub@localhost:5433/innovation_hub?schema=public"

# Claude API key (dedup, síntese, Canvas, PRD, aplicabilidade).
ANTHROPIC_API_KEY=""

# HTTP Basic auth gate (src/proxy.ts). Set BOTH in production to require login;
# leave empty locally to skip the gate.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""

# Only used by the local import script (scripts/import.ts) — not needed on Vercel.
REPORTS_DIR="./reports"
